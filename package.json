{
  "name": "film-collection-management-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:server:dev\" \"npm:client:dev\"",
    "server:dev": "node --env-file=.env --watch server/index.js",
    "client:dev": "vite --host 0.0.0.0 --port 5173",
    "test": "node --test --test-concurrency=1 tests/ocr.integration.test.js tests/tmdb-auth.test.js tests/controllers/movieController.test.js && node tests/run-e2e.js",
    "test:tmdb": "node --test --test-concurrency=1 tests/tmdb-auth.test.js",
    "test:e2e": "node tests/run-e2e.js",
    "test:ocr": "node --test tests/ocr.integration.test.js",
    "build": "vite build",
    "start": "node --env-file=.env server/index.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@emotion/react": "^11.11.11",
    "@emotion/styled": "^11.11.11",
    "@mui/icons-material": "^5.16.7",
    "@mui/material": "^5.16.7",
    "@prisma/client": "^5.20.0",
    "@zxing/library": "^0.23.0",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "helmet": "^8.3.0",
    "multer": "^2.0.0",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "sharp": "^0.33.0",
    "tesseract.js": "^7.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.10"
  }
}
