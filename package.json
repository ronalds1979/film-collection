{
  "name": "film-collection-management-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:api:dev\" \"npm:web:dev\"",
    "api:dev": "pnpm --filter @repo/api run dev",
    "web:dev": "pnpm --filter @repo/web run dev",
    "test": "node --test --test-concurrency=1 tests/ocr.integration.test.js tests/tmdb-auth.test.js tests/controllers/movieController.test.js && node tests/run-e2e.js",
    "test:tmdb": "node --test --test-concurrency=1 tests/tmdb-auth.test.js",
    "test:e2e": "node tests/run-e2e.js",
    "test:ocr": "node --test tests/ocr.integration.test.js",
    "build": "pnpm --filter @repo/web run build",
    "start": "pnpm --filter @repo/api run start",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.10"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.21.5": true,
    "prisma@5.22.0": true,
    "sharp@0.33.5": true,
    "tesseract.js@7.0.0": true
  }
}